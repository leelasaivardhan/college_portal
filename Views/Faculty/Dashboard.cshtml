@{ ViewData["Title"]="Faculty Dashboard"; var periods=ViewBag.Periods as List<Period> ?? new(); }
<div class="page-head"><div><span class="eyebrow">FACULTY</span><h1>Welcome, @ViewBag.Faculty?.FullName!</h1><p>@ViewBag.College?.Name</p></div></div>
@if(TempData["Success"] != null){<div class="toast success-toast">@TempData["Success"]</div>}
<div class="stats"><div><b>@ViewBag.SubjectCount</b><span>My Subjects</span></div><div><b>@periods.Count(x => x.Day == DateTime.Today.DayOfWeek)</b><span>Today's Classes</span></div><div><b>@ViewBag.Students</b><span>Total Students</span></div><a class="stat-link" asp-action="PendingActions"><b>@ViewBag.PendingActions</b><span>Pending Actions</span></a></div>
<div class="two-col"><section class="panel"><div class="panel-head"><h3>My Timetable</h3><a asp-action="MyPeriods">View all →</a></div>@foreach(var p in periods.Take(6)){<div class="notice"><b>@p.Day — @p.TimeSlot — @p.Subject</b><small>@p.ClassName / @p.Room</small></div>}</section><section class="panel"><h3>Quick Actions</h3><a class="action-btn" asp-action="AddMarks">➕ Add Marks</a><a class="action-btn" asp-action="Attendance">✅ Mark Attendance</a><a class="action-btn" asp-action="StudentList">👨‍🎓 Student List</a></section></div>
