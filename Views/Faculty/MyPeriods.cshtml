@{ ViewData["Title"]="My Periods"; var periods=ViewBag.Periods as List<Period> ?? new(); }
<div class="page-head"><div><span class="eyebrow">FACULTY</span><h1>My Periods</h1><p>Your assigned periods for the active college</p></div></div>
<div class="panel"><table><thead><tr><th>Day</th><th>Time</th><th>Subject</th><th>Class</th><th>Room</th></tr></thead><tbody>@foreach(var p in periods){<tr><td>@p.Day</td><td>@p.TimeSlot</td><td>@p.Subject</td><td>@p.ClassName</td><td>@p.Room</td></tr>}</tbody></table></div>
