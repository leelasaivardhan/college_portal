@{ ViewData["Title"]="Attendance"; var rows=ViewBag.Attendance as List<Attendance> ?? new(); }
<div class="page-head"><div><span class="eyebrow">STUDENT</span><h1>Attendance</h1><p>Your attendance records</p></div></div>
<div class="panel"><table><thead><tr><th>Date</th><th>Subject</th><th>Status</th></tr></thead><tbody>@foreach(var a in rows){<tr><td>@a.AttendanceDate.ToString("dd MMM yyyy")</td><td>@a.Subject</td><td><span class="status @(a.Present?"success":"danger")">@(a.Present?"Present":"Absent")</span></td></tr>}</tbody></table></div>
