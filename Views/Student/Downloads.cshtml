@{ ViewData["Title"]="Downloads"; var rows=ViewBag.Downloads as List<DownloadRecord> ?? new(); }
<div class="page-head"><div><span class="eyebrow">STUDENT</span><h1>Downloads</h1><p>Your downloaded college documents</p></div></div>
<div class="panel"><table><thead><tr><th>File</th><th>Downloaded On</th></tr></thead><tbody>@foreach(var x in rows){<tr><td>📄 @x.FileName</td><td>@x.DownloadedOn.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")</td></tr>}</tbody></table></div>
