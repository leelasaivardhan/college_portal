@{ ViewData["Title"]="Placements"; var eligible=(bool)(ViewBag.Eligible ?? false); var notices=ViewBag.PlacementNotices as List<Notice> ?? new(); }
<div class="page-head"><div><span class="eyebrow">STUDENT</span><h1>Placements</h1><p>Placement opportunities available to eligible students</p></div></div>
@if(!eligible){<div class="panel"><h3>Placement section not available yet</h3><p>Placement opportunities become visible when you reach the eligibility point after 3rd year, 2nd semester.</p></div>} else {<div class="panel"><h3>You are eligible for placement opportunities.</h3><p>Current placement announcements from your college are shown below.</p></div><div class="stack">@foreach(var n in notices){<article class="panel"><h3>@n.Title</h3><p>@n.Content</p></article>}</div>}
