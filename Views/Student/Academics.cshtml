@{ ViewData["Title"]="Academics"; var student=ViewBag.Student as AppUser; var college=ViewBag.College as College; }
<div class="page-head"><div><span class="eyebrow">STUDENT</span><h1>Academics</h1><p>Your academic information</p></div></div>
<div class="two-col"><section class="panel"><h3>Student Details</h3><div class="detail-grid"><div><span>Roll Number</span><b>@student?.RollNumber</b></div><div><span>Course</span><b>@student?.Course</b></div><div><span>Department</span><b>@student?.Department</b></div><div><span>Year</span><b>@student?.Year</b></div><div><span>Semester</span><b>@student?.Semester</b></div><div><span>College</span><b>@college?.Name</b></div></div></section><section class="panel"><h3>Academic Services</h3><a class="action-btn" asp-action="AcademicCalendar">📅 Academic Calendar</a><a class="action-btn" asp-action="Attendance">📈 Attendance</a><a class="action-btn" asp-action="Results">📊 Results</a><a class="action-btn" asp-action="Examinations">📝 Examinations</a></section></div>
