@model MultiCollegePortal.Models.Notice
@{ ViewData["Title"]="Add College Notice"; }
<div class="page-head"><div><span class="eyebrow">ADMIN</span><h1>Add College Notice</h1></div></div>
<div class="form-card"><form asp-action="AddNotice" method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><label>Title</label><input asp-for="Title" placeholder="Notice title"/><span asp-validation-for="Title" class="validation"></span><label>Content</label><textarea asp-for="Content" rows="7" placeholder="Enter notice content"></textarea><span asp-validation-for="Content" class="validation"></span><label>Category</label><select asp-for="Category"><option>General</option><option>Examination</option><option>Placement</option><option>Scholarship</option><option>Event</option></select><label>Publish</label><select asp-for="IsPublished"><option value="true">Yes</option><option value="false">No</option></select><button class="primary-btn" type="submit">Publish Notice</button></form></div>
