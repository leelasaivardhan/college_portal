@{ ViewData["Title"]="Admin Dashboard"; var colleges=ViewBag.Colleges as List<College> ?? new(); var college=ViewBag.College as College; }
<div class="page-head"><div><span class="eyebrow">ADMINISTRATION</span><h1>Administration Dashboard</h1><p>Manage the active college</p></div></div>
<div class="switcher"><form asp-action="SwitchCollege" method="post"><label>Current College</label><select name="collegeId" onchange="this.form.submit()">@foreach(var c in colleges){<option value="@c.Id" selected="@(c.Id == (int)ViewBag.ActiveCollegeId)">@c.Name</option>}</select></form></div>
<div class="stats"><div><b>@ViewBag.Students</b><span>Students</span></div><div><b>@ViewBag.Faculty</b><span>Faculty</span></div><div><b>@ViewBag.Notices</b><span>Notices</span></div><div><b>@ViewBag.Periods</b><span>Periods</span></div></div>
<div class="two-col"><section class="panel"><h3>Manage Content</h3><a class="action-btn" asp-action="ManageContent">📢 Add / Edit Notices</a><a class="action-btn" asp-action="CollegeManagement">🏫 College Information</a><a class="action-btn" asp-action="ExaminationManagement">📝 Examination Management</a></section><section class="panel"><h3>Timetable Management</h3><a class="action-btn" asp-action="AddPeriod">📅 Add Period</a><a class="action-btn" asp-action="TimetableManagement">🗓 View Timetable</a><a class="action-btn" asp-action="UserManagement">👥 Manage Users</a></section></div>
